# Local settings for the match and rating scripts (scripts/linux/*.sh and
# scripts/windows/*.ps1).
#
# Copy this file to scripts/local.env and fill in what differs on your
# machine. scripts/local.env is git-ignored: paths on your machine do not
# belong in the repository. Set VYVRAEL_LOCAL_ENV to read another file in
# place of scripts/local.env.
#
# Format: one KEY=VALUE per line. No quotes, no spaces around the "=", no
# variable expansion; everything after the "=" is the value, spaces included.
# Lines starting with "#" and empty lines are skipped. The file is read as
# text, never executed.
#
# Every setting can also be given as an environment variable with the prefix
# VYVRAEL_ (for example VYVRAEL_CONCURRENCY=3), and most as a command-line
# argument. The order is: argument, then environment, then this file, then
# the built-in default.

# Where the tools are. Leave commented out to find them on PATH.
#CUTECHESS_CLI=/path/to/cutechess-cli
#ORDO=/path/to/ordo

# The opening file (UHO_Lichess_4852_v1.epd). There is no built-in default.
#OPENINGS=/path/to/UHO_Lichess_4852_v1.epd

# The engine list in Cute Chess's engines.json format, used to look up
# gauntlet opponents by name. The installer writes one for the ladder.
#ENGINES_JSON=/path/to/engines.json

# Where PGN files, logs and run notes go. Default: matches in the current
# directory (git-ignored when run from the repository root).
#MATCH_DIR=/path/to/matches

# Games played at once. Default: physical cores minus two, at least one.
# Never more than the physical cores. On a small machine that is always on,
# "cores minus one" with LOW_PRIORITY=true is a reasonable choice.
#CONCURRENCY=3

# Physical cores of this machine, only if the scripts cannot detect them
# (they then say 0 physical cores in the run notes and check nothing).
#PHYSICAL_CORES=4

# Run the match at low priority (nice on Linux, BelowNormal on Windows).
# true or false. Default: false.
#LOW_PRIORITY=true

# Which build of the ladder's opponent engines scripts/install_tools.py
# installs: avx2 (the default) or pext. pext takes an engine's PEXT build
# where it has one (Arasan, Stash and Weiss; Ethereal too on Windows); PEXT
# is fast on Intel from Haswell and on AMD from Zen 3, slow on Zen 1 and
# Zen 2. Engines without a PEXT build are the same either way.
#ENGINE_BUILD=pext
